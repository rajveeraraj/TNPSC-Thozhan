# Application
APP_NAME="TNPSC தோழன்"
APP_ENV=production
APP_KEY=base64:f5LQ3uICbEjk0GxogGbpjRTZFKztwtKPGPndXSoQXQA=
APP_DEBUG=false
APP_URL=http://localhost:8000

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=info

# Database (MySQL Container)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=tnpsc_thozhan
DB_USERNAME=tnpsc_user
DB_PASSWORD=secret_password_2026
MYSQL_ROOT_PASSWORD=root_password_2026

# Seed on first launch
DB_SEED_ON_START=true

# Session, Cache & Queue
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# Redis (Optional)
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
